# Postgres connection string (Neon/Supabase both work, or Vercel Postgres storage tab)
DATABASE_URL=postgres://user:password@host/dbname

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Any random string, used to protect the /api/push/notify cron endpoint
CRON_SECRET=change-me
